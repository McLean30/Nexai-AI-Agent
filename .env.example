# ─────────────────────────────────────────────────────────────
# Nexai Digital — environment variables
# Copy to .env.local for local dev. In production set these in the
# hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Storage (REQUIRED for hosted/Vercel deployments) ──
# Durable database for prospects, settings and activity.
# Without these the app uses a local file store, which does NOT persist on
# serverless hosts like Vercel. Create a free database at https://upstash.com
# (Redis) and copy its REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Research & AI (optional — providers run in demo/mock mode when unset) ──
# Firecrawl: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Contact enrichment (optional) ──
ENRICHMENT_API_KEY=

# ── Microsoft 365 email (optional — live sending stays off by default) ──
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER=

# ── Misc ──
# Removes demo row/column limits (auto-enabled in development).
FIRE_ENRICH_UNLIMITED=true
